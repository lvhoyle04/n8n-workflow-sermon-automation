    {
      "parameters": {
        "jsCode": "// This merges multiple items' transcript fields into one full transcript\n\nlet fullTranscript = \"\";\n\nfor (const item of items) {\n  const text = item.json?.text || item.json?.body?.text || \"\";\n\n  if (text) {\n    fullTranscript += text.trim() + \"\\n\\n\";\n  }\n}\n\nreturn [\n  {\n    json: {\n      transcript: fullTranscript.trim()\n    }\n  }\n];"
      },
