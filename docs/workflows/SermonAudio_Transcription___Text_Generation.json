    },
    {
      "parameters": {
        "jsCode": "const data = items[0].binary.data.data;\nconst buffer = Buffer.from(data, 'base64');\n\n// Change the number of chunks here:\nconst chunkCount = 5;\nconst chunkSize = Math.ceil(buffer.length / chunkCount);\n\nconst outputs = [];\n\nfor (let i = 0; i < chunkCount; i++) {\n  const start = i * chunkSize;\n  const end = Math.min((i + 1) * chunkSize, buffer.length);\n  const chunk = buffer.slice(start, end);\n\n  outputs.push({\n    json: { index: i },\n    binary: {\n      data: {\n        data: chunk.toString('base64'),\n        mimeType: 'audio/mp3',\n        fileName: `chunk_${i}.mp3`,\n      },\n    },\n  });\n}\n\nreturn outputs;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
